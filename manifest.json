{
    "id": "cmspro.mddoc",
    "name": "Markdown文档",
    "description": "在线 Markdown 文档预览应用，支持文件夹分类、目录导航、搜索、代码高亮",
    "version": "1.1.0",
    "icon": "fa fa-file-text",
    "author": "CmsPro",
    "require": {
        "php": ">=8.3",
        "cmspro": ">=5.0.0"
    },
    "providers": [
        "ServiceProvider"
    ],
    "install": "Install",
    "menus": [
        {
            "title": "文档管理",
            "icon": "fa fa-file-text",
            "path": "/admin/cmspro/mddocs",
            "code": "admin_cmspro_mddoc_groups",
            "order": 100,
            "children": [
                {
                    "title": "文件管理",
                    "icon": "fa fa-folder-open",
                    "path": "/admin/cmspro/mddoc",
                    "code": "admin_cmspro_mddoc",
                    "order": 1
                },
                {
                    "title": "应用设置",
                    "icon": "fa fa-cog",
                    "path": "/admin/cmspro/mddoc/settings",
                    "code": "admin_cmspro_mddoc_settings",
                    "order": 2
                }
            ]
        }
    ],
    "config_groups": [
        {
            "name": "brand",
            "title": "前台品牌设置",
            "items": [
                {
                    "name": "brand_logo",
                    "title": "品牌图标（SVG）",
                    "type": "textarea",
                    "value": "<svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\"><path fill=\"currentColor\" d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 2l5 5h-5V4zM6 20V4h6v6h6v10H6z\"/></svg>",
                    "tips": "前台顶栏品牌图标，支持 SVG 代码，留空则不显示图标"
                },
                {
                    "name": "brand_name",
                    "title": "品牌名称",
                    "type": "text",
                    "value": "文档中心",
                    "tips": "前台顶栏品牌显示文字，留空则不显示文字"
                },
                {
                    "name": "brand_link",
                    "title": "品牌链接",
                    "type": "text",
                    "value": "/",
                    "tips": "点击品牌区域的跳转地址，支持站内相对路径（如 /）或完整 URL"
                }
            ]
        }
    ],
    "home_menus": [
        {
            "title": "文档中心",
            "path": "/docs",
            "code": "docs",
            "order": 10
        }
    ],
    "permissions": [
        {
            "code": "cmspro.mddoc.manage",
            "name": "文档管理"
        },
        {
            "code": "cmspro.mddoc.upload",
            "name": "上传文档"
        },
        {
            "code": "cmspro.mddoc.delete",
            "name": "删除文档"
        }
    ],
    "runtime_files": [
        {
            "key": "mddoc_docs",
            "name": "Markdown 文档库",
            "dir": "app/private/mddoc",
            "type": "other",
            "description": "文档应用的全部用户 Markdown 文档内容，属业务数据，禁止清理",
            "cleanable": false,
            "strategy": "protected",
            "protected": true
        }
    ]
}